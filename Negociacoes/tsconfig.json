{
  "compilerOptions": {
    "outDir": "app/dist/js",
    "target": "es2025",
    "rootDir": "./app/src",
    "noEmitOnError": true,
    "noImplicitAny": true,
    "removeComments": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["app/src/**/*"]
}
